{
  "name": "facturation-lussier",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo de l'application de facturation Lussier",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:local:reset": "node scripts/test-local-reset.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "npm run -w @facturation/db db:generate",
    "db:migrate": "npm run -w @facturation/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}

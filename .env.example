# --- Base de données (PostgreSQL via docker-compose) ---
DATABASE_URL="postgresql://facturation:facturation@localhost:5432/facturation?schema=public"

# --- API (NestJS) ---
API_PORT=4000
# Origine autorisée pour le CORS (frontend Vite)
WEB_ORIGIN="http://localhost:5173"

# --- Authentification JWT ---
# Secrets FORTS et DISTINCTS (ex: `openssl rand -hex 32`). Obligatoires : l'API
# refuse de démarrer s'ils sont absents.
JWT_ACCESS_SECRET=change-me-32-chars-minimum
JWT_REFRESH_SECRET=change-me-32-chars-different
# Durées de vie en secondes (access court, refresh long).
ACCESS_TTL=900
REFRESH_TTL=604800
# Cookie refresh : true en production (HTTPS), false en dev.
COOKIE_SECURE=false

# --- Compte admin initial (créé par `npm run -w @facturation/db db:seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# SMTP — envoi de factures par courriel (optionnel au démarrage, requis pour l'envoi)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=motdepasse
SMTP_FROM=Facturation Lussier <facturation@example.com>

// Prisma schema — jalon Authentification.
// Les modèles métier (clients, factures, taxes TPS/TVQ, paiements)
// seront ajoutés lors des étapes suivantes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Rôles
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------------------
// Utilisateurs
// ---------------------------------------------------------------------------

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(MEMBER)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  createdClients  Client[]
  createdInvoices Invoice[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Tokens de rafraîchissement (stockés hachés, avec rotation + révocation)
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Clients (entreprises ET particuliers facturés — B2B/B2C)
// ---------------------------------------------------------------------------

enum ClientType {
  COMPANY
  INDIVIDUAL
}

model Client {
  id          String     @id @default(cuid())
  type        ClientType @default(COMPANY)
  companyName String
  email       String?
  phone       String?
  addressLine String?
  city        String?
  province    String?  @default("QC")
  postalCode  String?
  country     String?  @default("Canada")
  neq         String?
  contactName String?
  notes       String?
  archivedAt  DateTime?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoices    Invoice[]
  contacts    Contact[]
  projects    Project[]

  @@index([companyName])
  @@index([archivedAt])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Profil de l'entreprise émettrice (singleton — en-tête des factures)
// ---------------------------------------------------------------------------

model IssuerProfile {
  id          String   @id @default(cuid())
  legalName   String
  email       String?
  phone       String?
  addressLine String?
  city        String?
  province    String?  @default("QC")
  postalCode  String?
  country     String?  @default("Canada")
  gstNumber   String?
  qstNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("issuer_profile")
}

// ---------------------------------------------------------------------------
// Factures (B2B — services) + lignes
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  BROUILLON
  ENVOYEE
  PAYEE
  ANNULEE
}

model Invoice {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  status        InvoiceStatus @default(BROUILLON)
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billingContactId String?
  billingContact   Contact?      @relation(fields: [billingContactId], references: [id], onDelete: SetNull)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?
  archivedAt    DateTime?
  subtotalCents Int           @default(0)
  gstCents      Int           @default(0)
  qstCents      Int           @default(0)
  totalCents    Int           @default(0)
  lines         InvoiceLine[]
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([archivedAt])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float
  unitPriceCents Int
  amountCents    Int
  position       Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------------------
// Contacts (personnes rattachées à une entreprise)
// ---------------------------------------------------------------------------

model Contact {
  id               String    @id @default(cuid())
  companyId        String
  company          Client    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  title            String?
  isBillingContact Boolean   @default(false)
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  projects         Project[] @relation("ProjectBillingContacts")
  invoices         Invoice[]

  @@index([companyId])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Projets (rattachés à une entreprise + contacts de facturation)
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIF
  TERMINE
}

model Project {
  id              String        @id @default(cuid())
  companyId       String
  company         Client        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  status          ProjectStatus @default(ACTIF)
  notes           String?
  archivedAt      DateTime?
  billingContacts Contact[]     @relation("ProjectBillingContacts")
  invoices        Invoice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@map("projects")
}

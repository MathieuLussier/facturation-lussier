{
  "name": "facturation-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Coquille Electron de Facturation Lussier — charge l'app web (VPS) et ajoute la numérisation native (scanner de l'imprimante).",
  "author": "Mathieu Lussier",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rimraf dist release",
    "build": "tsc -p tsconfig.json && node scripts/copy-resources.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && cross-env FACT_DEV=1 electron .",
    "build:win": "npm run build && electron-builder --win --x64",
    "publish:win": "npm run build && electron-builder --win --x64 --publish always",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "image-size": "^1.1.1",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "cross-env": "^7.0.3",
    "electron": "^33.4.3",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
